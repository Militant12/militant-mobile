# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# APK files - too large for Git
*.apk
*.aab

# Signing keys - NEVER COMMIT THESE!
android/key.properties
*.jks
*.keystore
MOTS_DE_PASSE_KEYSTORE.txt

# Documentation and notes files
A_FAIRE.txt
GITLAB_VARIABLES.txt
RESUME_RAPIDE.txt

# Mobile-only scope (exclude desktop/web packaging)
/linux/
/macos/
/windows/
/web/
*.deb
militant-v*/
militant-linux_*.deb
package_linux.sh
package_macos.sh
